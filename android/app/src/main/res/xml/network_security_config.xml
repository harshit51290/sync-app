<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The receiver is a plain HTTP server on the local network; there is no
         public endpoint to protect. Everything stays inside the Wi-Fi. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
