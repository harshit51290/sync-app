<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PhoneSync" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lime</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorPrimaryContainer">@color/lime_dim</item>
        <item name="colorOnPrimaryContainer">@color/lime</item>
        <item name="colorSecondary">@color/lime</item>
        <item name="colorOnSecondary">@color/bg</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/panel_hi</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line_strong</item>
        <item name="colorError">@color/bad</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="materialButtonStyle">@style/Widget.PhoneSync.Button</item>
    </style>

    <style name="Widget.PhoneSync.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:minHeight">46dp</item>
    </style>

    <style name="Widget.PhoneSync.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="strokeColor">@color/line_strong</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.PhoneSync.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/lime_dim</item>
    </style>

    <style name="Widget.PhoneSync.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/panel</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="TextTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextSection">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextBody">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextCaption">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <style name="TextMono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>
